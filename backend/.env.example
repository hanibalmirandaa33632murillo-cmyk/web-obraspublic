# Copia este archivo como .env en la carpeta backend/ para desarrollo local
# En Railway, configura estas variables desde el panel de tu proyecto.

# Conexion a PostgreSQL
DATABASE_URL=postgresql://obras_user:obras_pass@localhost:5432/obras_publicas

# En Railway, el valor lo genera automaticamente al agregar un plugin PostgreSQL
# Ejemplo: DATABASE_URL=postgresql://postgres:XXXX@monorail.proxy.rlwy.net:XXXX/railway
