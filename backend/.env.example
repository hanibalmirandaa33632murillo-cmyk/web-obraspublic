# ══════════════════════════════════════════════════════
# Copia este archivo como .env en la carpeta backend/
# En Railway configura estas variables en el panel
# ══════════════════════════════════════════════════════

# Conexion a PostgreSQL
# En Railway: copia el valor de DATABASE_URL del plugin PostgreSQL
DATABASE_URL=postgresql://obras_user:obras_pass@localhost:5432/obras_publicas

# Clave secreta para firmar los tokens JWT
# IMPORTANTE: genera una clave segura con este comando en tu terminal:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Pega el resultado aqui
SECRET_KEY=REEMPLAZA_ESTO_CON_UNA_CLAVE_GENERADA

# Algoritmo de firma (no cambies esto)
ALGORITHM=HS256

# Minutos de duracion del token (60 = 1 hora)
ACCESS_TOKEN_EXPIRE_MINUTES=60
