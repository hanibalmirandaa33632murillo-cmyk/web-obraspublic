# frontend/.env.example
# Copia este archivo como .env para desarrollo local

# URL del backend corriendo localmente con docker
VITE_API_URL=http://localhost:8000

# En produccion NO edites este archivo.
# En su lugar, ve a tu repo de GitHub:
#   Settings → Secrets and variables → Actions → New repository secret
#   Nombre: VITE_API_URL
#   Valor:  la URL publica de Railway (ej: https://web-obraspublic-production.up.railway.app)
#           La encuentras en Railway → tu servicio backend → Settings → Public Networking
